# ---- 服务 ----
NODE_ENV=production
# 多数云平台会自动注入 PORT，本地可留空使用默认 3000
PORT=3000

# ---- 数据库（必填）----
# 例：postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/genie

# ---- 管理后台鉴权（务必修改）----
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- 跨域 ----
# 一体化部署（同源）保持 * 即可；如前端独立部署则填前端域名
CORS_ORIGIN=*
